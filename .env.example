# ============================================================
# Caterpillar Smart Rental Tracking System — Environment Config
# ============================================================

# Django Core
DEBUG=true
SECRET_KEY=change-me-use-a-long-random-string-in-production
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database (Caterpillar Fleet DB)
DATABASE_NAME=cat_smart_rental_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Redis (Cache & Channels layer)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# MQTT Broker (Mosquitto - IoT Telemetry from Cat machines)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_TELEMETRY=cat/fleet/telemetry/+
MQTT_TOPIC_ALERTS=cat/fleet/alerts/+

# Kafka (Event Streaming)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TELEMETRY=telemetry-events
KAFKA_TOPIC_RENTALS=rental-events
KAFKA_TOPIC_ANOMALIES=anomaly-events
KAFKA_TOPIC_RECOMMENDATIONS=recommendation-events

# JWT Auth
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS (Frontend origin)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Cat Telematics / VisionLink API (optional integration)
CAT_VISIONLINK_API_URL=https://api.cat.com/visionlink/v1
CAT_VISIONLINK_API_KEY=your-visionlink-api-key

# Prometheus
PROMETHEUS_METRICS_ENABLED=true
